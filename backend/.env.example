# Required. SQLAlchemy URL using the psycopg (v3) driver.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@localhost:5432/ai_interview_coach

# development | test | production  (production disables /docs and /openapi.json)
ENVIRONMENT=development

API_HOST=127.0.0.1
API_PORT=8000

# Comma-separated exact origins allowed to call the API. '*' is rejected.
CORS_ORIGINS=http://localhost:3000

# Marks the session cookie Secure (HTTPS only). true whenever the API is served over HTTPS;
# false for plain-HTTP local development, or the browser drops the cookie.
AUTH_COOKIE_SECURE=false

# Largest accepted resume PDF, in whole MB (1-20). Larger uploads get 413 and are not read further.
MAX_RESUME_SIZE_MB=5

# ---------- AI model gateway (optional) ----------
# Empty = AI disabled; resume upload and rule-based extraction work without it.
# Comma-separated, in order: first is the primary, the rest are fallbacks. groq | gemini | nvidia
# Every provider listed needs both its *_API_KEY and *_MODEL, or the backend refuses to start.
AI_PROVIDERS=
# Per attempt. Worst case per AI request: providers x (AI_MAX_RETRIES + 1) x timeout + backoff.
AI_TIMEOUT_SECONDS=20
# Extra attempts per provider, for transient errors only (timeouts, 429, 5xx, invalid output).
AI_MAX_RETRIES=1
AI_MAX_OUTPUT_TOKENS=8192

# Keys are secrets: set them only in backend/.env (never here, never in the frontend).
# Choose models that support JSON-schema structured output on that provider.
# Live-verified 2026-10-01: GROQ_MODEL=openai/gpt-oss-120b, GEMINI_MODEL=gemini-2.5-flash,
# NVIDIA_MODEL=nvidia/nemotron-3-super-120b-a12b. Re-run tests/test_live_providers.py if you change one.
GROQ_API_KEY=
GROQ_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=
NVIDIA_API_KEY=
NVIDIA_MODEL=

# Tests never use DATABASE_URL directly: they use the same URL with '_test' appended to the
# database name (e.g. ai_interview_coach_test), which must exist. To use a different database,
# export TEST_DATABASE_URL in your shell (it is read from the environment, not from this file).
